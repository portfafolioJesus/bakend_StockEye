# =====================================================================
#  StockEye · variables de entorno. Copia este archivo a .env y complétalo.
#  .env NUNCA se sube a git (contiene secretos).
# =====================================================================

# --- General ---------------------------------------------------------
# desarrollo | produccion
ENTORNO=produccion
STOCKEYE_VERSION=latest
# el panel queda en http://servidor:8080
WEB_PUERTO=8080
CORS_ORIGENES=http://localhost:5173,http://localhost:8080

# --- Base de datos (PostgreSQL 16 en Docker) --------------------------
POSTGRES_USER=stockeye
# OBLIGATORIO: openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=stockeye
# puerto en el host para DBeaver (5432 lo usa tu Postgres local)
POSTGRES_PUERTO=5433
# 0.0.0.0 solo si DBeaver se conecta desde otro equipo
POSTGRES_BIND=127.0.0.1
# DATABASE_URL la arma docker-compose. Sin Docker (desarrollo):
# DATABASE_URL=postgresql://stockeye:<clave>@localhost:5433/stockeye

# --- Seguridad --------------------------------------------------------
# OBLIGATORIO: openssl rand -hex 32
JWT_SECRETO=
JWT_MINUTOS_ACCESO=720
JWT_DIAS_REFRESCO=30

# --- API ---------------------------------------------------------------
# procesos uvicorn
API_WORKERS=2
MAX_FOTO_MB=15
# aplica db/migraciones al iniciar
AUTO_MIGRAR=true

# --- Inferencia (worker) ----------------------------------------------
# carpeta del host con los .onnx
MODELOS_HOST=./backend/modelos
# * = todos; "R01,R02" = worker dedicado
WORKER_RECINTOS=*
# vacío = lo que recomienda el manifiesto del modelo
ORT_HILOS=
# cpu | cuda (requiere imagen con onnxruntime-gpu)
INFERENCIA_DISPOSITIVO=cpu
# avisa en el log si una foto tarda más
INFERENCIA_PRESUPUESTO_S=3
# tras esto, una foto "PROCESANDO" vuelve a la cola
LEASE_MINUTOS=5

# --- Fotos reales por carpeta (servicio importador) -------------------
# carpeta del host donde se dejan las fotos: <RECINTO>/<GÓNDOLA>/foto.jpg
ENTRADAS_HOST=./entradas
IMPORTADOR_INTERVALO_S=5

# --- Notificaciones push ----------------------------------------------
# carpeta del host montada en /secretos (solo lectura)
SECRETOS_HOST=./secretos
FCM_CREDENCIALES=/secretos/firebase-cuenta-servicio.json
# docker compose run --rm api python -m stockeye.cli vapid
VAPID_PUBLICA=
VAPID_PRIVADA=
VAPID_CONTACTO=mailto:soporte@tu-empresa.cl

# --- IA de producto (intercambiable) ----------------------------------
# groq | openai  (el panel permite cambiarlo)
IA_PROVEEDOR=groq
# https://console.groq.com/keys
GROQ_API_KEY=
# vacío = el elegido en el panel (por defecto qwen/qwen3.8-27b)
IA_MODELO=
IA_TIMEOUT_S=30
# OPENAI_API_KEY=
